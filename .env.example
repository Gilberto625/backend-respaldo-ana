MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?appName=proyecto
PORT=4000

# Origen permitido del frontend
FRONTEND_ORIGIN=http://localhost:3000

# SMTP para Nodemailer
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-app-password

# JWT Secret para tokens
JWT_SECRET=tu-jwt-secret-aqui

# Session Secret para express-session
SESSION_SECRET=tu-session-secret-aqui

# Google OAuth Configuration
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/usuarios/auth/google/callback

# Frontend URL (para redirección después de autenticación)
FRONTEND_URL=http://localhost:3000
